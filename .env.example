# Copy to .env and fill in your own values. .env is never committed.

APP_ENV=development
DATABASE_URL=sqlite:///aftercare.db
STORAGE_DIR=storage

# Where the two programs run (the browser is sent to these addresses).
BACKEND_URL=http://localhost:8000
UI_URL=http://localhost:8080

# Google sign-in: create your own OAuth test client (see TEAM_SETUP.md).
# Redirect URI: http://localhost:8000/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Any long random string, for example: python -c "import secrets; print(secrets.token_urlsafe(32))"
LOGIN_STATE_SECRET=

# Claude models (ADR-0018). Change a model only after re-running the eval suite.
MODEL_MAIN=claude-sonnet-5-5
MODEL_FAST=claude-haiku-5-5
MODEL_STRONG=claude-opus-5-5

# Developer-only. Writes patient text to logs. Refused when APP_ENV=production. Synthetic data only.
LOG_PATIENT_TEXT=0
